GEMINI_API_KEY=your_gemini_api_key
# Used by ADK agents via LiteLLM (optional if using Gemini-only paths)
GROQ_API_KEY=
# Supabase Postgres (Settings → Database → URI). Include ?sslmode=require if required.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Use sample JSON for weather when true; when false, live placeholder from weather_service.
DEMO_MODE=true
