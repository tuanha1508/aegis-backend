GEMINI_API_KEY=your_gemini_api_key
# ADK Web / google-genai often expect this name; orchestrator maps GEMINI_API_KEY if unset.
GOOGLE_API_KEY=
# Used by ADK agents via LiteLLM (optional if using Gemini-only paths)
GROQ_API_KEY=
# Set false when running pytest to avoid background orchestration ticks
AUTO_ORCHESTRATE=true
# Supabase Postgres (Settings → Database → URI). Include ?sslmode=require if required.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Use sample JSON for weather when true; when false, live placeholder from weather_service.
DEMO_MODE=true
